{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "canvas",
          "name": "Canvas",
          "color": "#ffffff"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#f4f4f1"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#171717"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#62625f"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#1d5b4f"
        },
        {
          "slug": "accent-dark",
          "name": "Accent dark",
          "color": "#123c34"
        }
      ]
    },
    "layout": {
      "contentSize": "45rem",
      "wideSize": "75rem"
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "name": "2XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "S",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "M",
          "size": "clamp(1.5rem, 1.15rem + 1vw, 2rem)"
        },
        {
          "slug": "60",
          "name": "L",
          "size": "clamp(2rem, 1.3rem + 2vw, 3rem)"
        },
        {
          "slug": "70",
          "name": "XL",
          "size": "clamp(3rem, 2rem + 3vw, 5rem)"
        },
        {
          "slug": "80",
          "name": "2XL",
          "size": "clamp(4rem, 2.5rem + 5vw, 7rem)"
        }
      ],
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "serif",
          "name": "Serif",
          "fontFamily": "Georgia, \"Times New Roman\", serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.125rem, 1rem + 0.4vw, 1.375rem)"
        },
        {
          "slug": "x-large",
          "name": "Extra large",
          "size": "clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem)"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(2.5rem, 1.5rem + 3.5vw, 4.75rem)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40",
      "padding": {
        "left": "var:preset|spacing|40",
        "right": "var:preset|spacing|40"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "0.25rem"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|canvas"
        },
        "spacing": {
          "padding": {
            "bottom": "0.75rem",
            "left": "1.25rem",
            "right": "1.25rem",
            "top": "0.75rem"
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600"
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "650",
          "letterSpacing": "-0.025em",
          "lineHeight": "1.15"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "core/post-content": {
        "spacing": {
          "blockGap": "var:preset|spacing|40"
        }
      },
      "core/site-title": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "700",
          "letterSpacing": "-0.02em"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
